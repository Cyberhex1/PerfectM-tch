# All optional — the app runs in guest mode with on-device analysis without any of these.

# Accounts + cloud sync (free): https://supabase.com — see README "Accounts"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI skin read (free tier): https://aistudio.google.com/apikey — server-side only, never exposed to the browser
GEMINI_API_KEY=
# Optional: pin a model id (falls back automatically if it's retired)
GEMINI_MODEL=

# Optional: contact URL/email sent in the User-Agent to Open Beauty Facts (their API etiquette)
OBF_CONTACT=
